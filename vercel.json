{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/learning-notes/:id", "destination": "/api/learning-notes" },
    { "source": "/api/instructor-notices", "destination": "/api/learning-notes" },
    { "source": "/api/instructor-notices/:id", "destination": "/api/learning-notes" },
    { "source": "/api/instructor-materials", "destination": "/api/learning-notes" },
    { "source": "/api/instructor-materials/:id", "destination": "/api/learning-notes" },
    { "source": "/api/admin/instructor-notices", "destination": "/api/learning-notes" },
    { "source": "/api/admin/instructor-notices/:id", "destination": "/api/learning-notes" }
  ],

  "headers" : [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source" : "/(.*)",
      "headers": [
        {
          "key" : "X-Content-Type-Options",
          "value" : "nosniff"
        }
      ]
    }
  ]
}
